# Server only. Never prefix secrets with VITE_.
GEMINI_API_KEY=
# Set a model actually available to your Gemini account; no hardcoded fallback.
GEMINI_MODEL=
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
FIREBASE_PROJECT_ID=
# Path to service-account JSON outside repository; prefer workload identity in cloud.
GOOGLE_APPLICATION_CREDENTIALS=
APP_URL=http://localhost:3000
PORT=3000
# For isolated development only; never use demo settings for production.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
