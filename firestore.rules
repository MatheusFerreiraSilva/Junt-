rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function couplePath(coupleId) {
      return /databases/$(database)/documents/couples/$(coupleId);
    }

    function myCoupleId() {
      return isAuthenticated() && exists(userDocPath(request.auth.uid))
        ? get(userDocPath(request.auth.uid)).data.coupleId
        : null;
    }

    // Used for subcollections and invite docs: reads the parent couple.
    function isCoupleMemberById(coupleId) {
      return isAuthenticated() && (
        myCoupleId() == coupleId ||
        (exists(couplePath(coupleId)) &&
          (get(couplePath(coupleId)).data.partner1Uid == request.auth.uid ||
           get(couplePath(coupleId)).data.partner2Uid == request.auth.uid))
      );
    }

    // Used for the couple document itself: avoids get() on the same doc.
    function isCoupleMemberResource(coupleId) {
      return isAuthenticated() && (
        myCoupleId() == coupleId ||
        resource.data.partner1Uid == request.auth.uid ||
        resource.data.partner2Uid == request.auth.uid
      );
    }

    // User profile matching auth uid
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Couple shared document. No list(): invite lookup goes through
    // coupleInvites/{code} so a client cannot enumerate couples.
    match /couples/{coupleId} {
      allow get: if isCoupleMemberResource(coupleId);
      allow create: if isAuthenticated() &&
        request.resource.data.partner1Uid == request.auth.uid;
      allow update, delete: if isCoupleMemberResource(coupleId);

      match /{allChildren=**} {
        allow read, write: if isCoupleMemberById(coupleId);
      }
    }

    // Public invite lookup: the 6-char code is the secret. Only coupleId is
    // stored here. Any authenticated user with the code can read the mapping,
    // but only couple members can create/update/delete it.
    match /coupleInvites/{inviteCode} {
      allow get: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.coupleId is string &&
        isCoupleMemberById(request.resource.data.coupleId);
      allow update, delete: if isAuthenticated() &&
        isCoupleMemberById(resource.data.coupleId);
      // No list: codes cannot be enumerated.
    }
  }
}
