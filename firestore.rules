rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(data) {
      return signedIn() && (!('departedMembers' in data) || !(request.auth.uid in data.departedMembers) || data.departedMembers[request.auth.uid] != true) && (data.partner1Uid == request.auth.uid || data.partner2Uid == request.auth.uid);
    }
    function memberOf(coupleId) {
      return signedIn() && exists(/databases/$(database)/documents/couples/$(coupleId))
        && member(get(/databases/$(database)/documents/couples/$(coupleId)).data);
    }
    function safeDisplayName(data) {
      return !('displayName' in data) || (data.displayName is string && data.displayName.size() <= 80);
    }
    function validRecord(field, record) {
      return record is map && record.id is string && record.id.size() > 0 && record.id.size() <= 1024
        && !record.keys().hasAny(['pluggyCredentials', 'clientSecret', 'apiKey', 'accessToken'])
        && (!(field in ['expenses', 'incomes', 'bankImportedTransactions']) ||
          (record.amount is number && record.amount >= 0 && record.amount <= 90071992547409))
        && (!('paidBy' in record) || record.paidBy in ['partner1', 'partner2', 'both', 'custom'])
        && (!('recipient' in record) || record.recipient in ['partner1', 'partner2', 'both', 'custom']);
    }
    function validEntity(data) {
      return data.keys().hasOnly(['field', 'record', 'deleted', 'schemaVersion'])
        && data.keys().hasAll(['field', 'record', 'deleted', 'schemaVersion'])
        && data.field in ['expenses', 'incomes', 'installments', 'piggyBanks', 'strategicIntents', 'medicalShifts', 'shiftIncomeAllocations', 'bankImportedTransactions', 'medicalShiftPresets', 'hospitalMappingRules', 'incomeSourceRules', 'pendingConfirmations', 'linkedAccounts', 'detectedSubscriptions', 'keywordRules', 'coupleGoals', 'coupleWishlist', 'coupleFixedBills', 'dreamSimulations', 'pluggyAccounts']
        && data.schemaVersion == 1 && data.deleted is bool
        && ((data.deleted && data.record == null) || (!data.deleted && validRecord(data.field, data.record)));
    }
    function safeAmount(data, key) {
      return !(key in data) || (data[key] is number && data[key] >= 0 && data[key] <= 90071992547409);
    }
    function validMetadata(data) {
      return safeAmount(data, 'partner1Income') && safeAmount(data, 'partner2Income')
        && safeAmount(data, 'protectionCurrentAmount') && safeAmount(data, 'protectionTotalInvested')
        && safeAmount(data, 'freedomTotalInvested')
        && (!('investmentsPercentage' in data) || (data.investmentsPercentage is number && data.investmentsPercentage >= 0 && data.investmentsPercentage <= 100))
        && (!('partner1Name' in data) || (data.partner1Name is string && data.partner1Name.size() <= 80))
        && (!('partner2Name' in data) || (data.partner2Name is string && data.partner2Name.size() <= 80))
        && (!('isProtectionComplete' in data) || data.isProtectionComplete is bool);
    }
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      // Association and roles are assigned transactionally by the authenticated server.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName'])
        && request.resource.data.uid == uid && safeDisplayName(request.resource.data)
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 320));
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && safeDisplayName(request.resource.data);
    }
    match /couples/{coupleId} {
      allow get: if member(resource.data);
      allow update: if member(resource.data) && validMetadata(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'categoryPercentages', 'categoryFloors', 'partner1Career', 'partner2Career',
          'partner1Income', 'partner2Income', 'partner1Name', 'partner2Name', 'investmentsPercentage',
          'protectionCurrentAmount', 'protectionTotalInvested', 'isProtectionComplete',
          'freedomTotalInvested', 'monthlyDepositGuides', 'completedMonthDeposits',
          'surplusTransfers', 'dismissedSurplusMonths', 'updatedAt', 'lastUpdatedBy'
        ])
        && !request.resource.data.keys().hasAny(['pluggyCredentials']);
      // Creation, membership changes and deletion are server-only operations.
      match /entities/{entityId} {
        allow read: if memberOf(coupleId);
        allow create: if memberOf(coupleId) && validEntity(request.resource.data);
        allow update: if memberOf(coupleId) && validEntity(request.resource.data)
          && request.resource.data.field == resource.data.field
          && (resource.data.deleted || request.resource.data.deleted || request.resource.data.record.id == resource.data.record.id);
        // Deletions are tombstones, preventing legacy arrays from resurrecting records.
        allow delete: if false;
      }
    }

    // Compact owner-bound recipes; active partners may edit each other.
    // Client transactions and the API enforce the same revision contract.
    function avatarAccountSignedIn() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function avatarPairInCouple(coupleId, targetUid) {
      let couple = get(/databases/$(database)/documents/couples/$(coupleId)).data;
      return member(couple)
        && (couple.partner1Uid == targetUid || couple.partner2Uid == targetUid)
        && (!('departedMembers' in couple) || !(targetUid in couple.departedMembers) || couple.departedMembers[targetUid] != true);
    }
    function avatarSharedWith(targetUid) {
      let readerPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let targetPath = /databases/$(database)/documents/users/$(targetUid);
      return exists(readerPath) && exists(targetPath)
        && get(readerPath).data.coupleId is string
        && get(readerPath).data.coupleId.size() > 0
        && get(targetPath).data.coupleId == get(readerPath).data.coupleId
        && avatarPairInCouple(get(readerPath).data.coupleId, targetUid);
    }
    function validAvatar(data, uid) {
      return data.keys().hasAll(['ownerUid', 'revision', 'config'])
        && data.keys().hasOnly(['ownerUid', 'revision', 'config'])
        && data.ownerUid == uid && data.revision is int && data.revision > 0 && data.revision <= 9007199254740991
        && data.config is map
        && data.config.keys().hasAll(["version","gender","skin","hairColor","hair","eyeColor","eyes","mouth","outfit","outfitColor","accessory"])
        && data.config.keys().hasOnly(["version","gender","skin","hairColor","hair","eyeColor","eyes","mouth","outfit","outfitColor","accessory"])
        && data.config.version == 1
        && data.config.gender in ["feminine","masculine"]
        && data.config.skin in ["porcelain","peach","honey","caramel","cocoa","umber","espresso"]
        && data.config.hairColor in ["ink","brown","chestnut","copper","gold","silver","rose","violet"]
        && data.config.hair in ["crop","fade","quiff","sweep","waves","curls","coils","bob","long","ponytail","bun","braids","bald"]
        && data.config.eyeColor in ["brown","dark","hazel","green","blue"]
        && data.config.eyes in ["soft","almond","bright","happy"]
        && data.config.mouth in ["smile","grin","calm","joy"]
        && data.config.outfit in ["scrub","labcoat","tee","shirt","hoodie","cardigan","jacket"]
        && data.config.outfitColor in ["surgicalGreen","navy","burgundy","white","teal","sage","blue","lilac","rose","clay","ochre","charcoal","cream"]
        && data.config.accessory in ["none","stethoscope","headphones","backpack","bag","soccer","round","square","sunglasses","earrings","freckles","beard"];
    }
    function avatarAccess(uid) {
      return avatarAccountSignedIn() && (request.auth.uid == uid || avatarSharedWith(uid));
    }
    match /avatars/{uid} {
      allow get: if avatarAccess(uid);
      allow create: if avatarAccess(uid) && validAvatar(request.resource.data, uid) && request.resource.data.revision == 1;
      allow update: if avatarAccess(uid) && validAvatar(request.resource.data, uid)
        && resource.data.ownerUid == uid && resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1;
      allow list, delete: if false;
    }
    function validPreferenceColors(p) {
      return p is map && p.keys().hasAll(['themeMode', 'accentTheme', 'coupleTheme', 'partner1Theme', 'partner2Theme'])
        && p.keys().hasOnly(['themeMode', 'accentTheme', 'coupleTheme', 'partner1Theme', 'partner2Theme'])
        && p.themeMode in ['light', 'dark']
        && p.accentTheme in ['emerald', 'sapphire', 'violet', 'rose', 'amber', 'slate']
        && p.coupleTheme in ['emerald', 'sapphire', 'violet', 'rose', 'amber', 'slate']
        && p.partner1Theme in ['emerald', 'sapphire', 'violet', 'rose', 'amber', 'slate']
        && p.partner2Theme in ['emerald', 'sapphire', 'violet', 'rose', 'amber', 'slate'];
    }
    function validPreferences(data, uid) {
      return data.keys().hasAll(['ownerUid', 'version', 'revision', 'preferences'])
        && data.keys().hasOnly(['ownerUid', 'version', 'revision', 'preferences'])
        && data.ownerUid == uid && data.version == 1 && data.revision is int && data.revision > 0 && data.revision < 9007199254740991
        && validPreferenceColors(data.preferences);
    }
    match /accountPreferences/{uid} {
      allow get: if avatarAccountSignedIn() && request.auth.uid == uid;
      allow create: if avatarAccountSignedIn() && request.auth.uid == uid
        && validPreferences(request.resource.data, uid) && request.resource.data.revision == 1;
      allow update: if avatarAccountSignedIn() && request.auth.uid == uid
        && validPreferences(request.resource.data, uid) && resource.data.ownerUid == uid
        && request.resource.data.revision == resource.data.revision + 1;
      allow list, delete: if false;
    }

    // Invite hashes, provider tokens, item ownership and rate-limit records are server-only.
    match /coupleInvites/{code} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
